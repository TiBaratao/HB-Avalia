                         "react":  "^19.1.1",
                         "react-dom":  "^19.1.1"
                     },
    "devDependencies":  {
                            "@firebase/rules-unit-testing":  "^5.0.2",
                            "@types/node":  "^22.15.30",
                            "@types/react":  "^19.1.13",
                            "@types/react-dom":  "^19.1.9",
                            "eslint":  "^8.57.1",
                            "eslint-config-next":  "^15.5.28",
                            "typescript":  "^5.9.2"
                        },
    "overrides":  {
