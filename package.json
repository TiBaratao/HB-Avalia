{
    "name": "hb-avalia",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "next start",
        "test:rules": "firebase emulators:exec --only firestore --project demo-hb-avalia \"node --test tests/firestore.rules.test.mjs\"",
        "test:organization-structure": "firebase emulators:exec --only firestore --project demo-hb-avalia-org \"node --test tests/organization-structure-emulator.test.mjs\"",
        "test:server-actions": "firebase emulators:exec --only firestore --project demo-hb-avalia \"node --import ./tests/register-server-only.mjs --conditions=react-server --experimental-strip-types --test functions/test/secure-actions-emulator.test.js tests/invitations-emulator.test.mjs tests/director-access-emulator.test.mjs tests/organization-management-emulator.test.mjs tests/promotion-access-emulator.test.mjs\"",
        "provision:organization:emulator": "firebase emulators:exec --only firestore --project demo-hb-avalia-org \"node scripts/provision-organization.mjs\"",
        "provision:director:emulator": "firebase emulators:exec --only firestore --project demo-hb-avalia-org \"node scripts/provision-director-emulator.mjs\"",
        "build": "next build",
        "lint": "eslint src functions tests",
        "typecheck": "tsc --noEmit",
        "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes --project hb-avalia2",
        "test": "node --test functions/test/domain.test.js functions/test/scheduled-checklists.test.js tests/organization-analytics.test.mjs",
        "check": "npm run typecheck && npm run lint && npm test && npm run test:rules",
        "dev": "next dev"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.6",
        "firebase": "^12.19.0",
        "firebase-admin": "^13.10.0",
        "framer-motion": "^14.0.0",
        "next": "^15.5.4",
        "qrcode.react": "^4.2.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "eslint": "^8.57.1",
        "eslint-config-next": "^15.5.28",
        "typescript": "^5.9.2"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.14.6",
        "uuid": "^11.1.1",
        "next": {
            "postcss": "8.5.30"
        }
    }
}
