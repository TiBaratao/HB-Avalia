{
    "name":  "hb-avalia",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "start":  "next start",
                    "test:rules":  "firebase emulators:exec --only firestore --project demo-hb-avalia \"node --test tests/firestore.rules.test.mjs\"",
                    "build":  "next build",
                    "lint":  "eslint src functions tests",
                    "typecheck":  "tsc --noEmit",
                    "deploy:firebase":  "firebase deploy --only functions,firestore:rules,firestore:indexes --project hb-avalia",
                    "test":  "node --test functions/test/domain.test.js",
                    "check":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm test \u0026\u0026 npm run test:rules",
                    "dev":  "next dev"
                },
    "dependencies":  {
                         "@phosphor-icons/react":  "^2.1.10",
                         "firebase":  "^12.19.0",
                         "framer-motion":  "^14.0.0",
